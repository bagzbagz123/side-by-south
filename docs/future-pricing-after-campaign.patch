diff --git a/tests/regular-pricing.test.mjs b/tests/regular-pricing.test.mjs
new file mode 100644
index 0000000..5c56e20
--- /dev/null
+++ b/tests/regular-pricing.test.mjs
@@ -0,0 +1,122 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { test } from "node:test";
+import vm from "node:vm";
+
+const source = readFileSync(resolve(import.meta.dirname, "../public/packages.js"), "utf8");
+const money = value => new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(value);
+
+function page(search = "") {
+  const nodes = new Map();
+  const events = [];
+  let clipboard = "";
+  const node = selector => {
+    if (!nodes.has(selector)) {
+      const attributes = new Map();
+      nodes.set(selector, {
+        value: "", checked: false, hidden: false, textContent: "", listeners: new Map(),
+        addEventListener(name, callback) { this.listeners.set(name, callback); },
+        setAttribute(name, value) { attributes.set(name, value); },
+        getAttribute(name) { return attributes.get(name) ?? null; },
+      });
+    }
+    return nodes.get(selector);
+  };
+  const modes = ["bundle", "media"].map(value => Object.assign(node(`input[name="package-mode"][value="${value}"]`), { value }));
+  const coverage = ["photo", "film", "both"].map(value => Object.assign(node(`input[name="coverage"][value="${value}"]`), { value }));
+  const builder = Object.assign(node("#coverage.coverage-builder"), {
+    querySelector: node,
+    querySelectorAll(selector) { return selector === 'input[name="package-mode"]' ? modes : selector === 'input[name="coverage"]' ? coverage : []; },
+  });
+  const form = Object.assign(node("#inquiry-form"), { elements: { coverage: node("form-coverage") } });
+  const document = {
+    querySelector: node,
+    querySelectorAll(selector) { return selector === '[data-package-offer="velvet-photo-film"]' ? [node("offer-link")] : []; },
+    dispatchEvent(event) { events.push(event); },
+  };
+  const window = { SBSAttribution: { ad_id: "120255499730570357" } };
+  new vm.Script(source, { filename: "public/packages.js" }).runInNewContext({
+    document, window, location: { search }, URLSearchParams, Intl,
+    navigator: { clipboard: { async writeText(value) { clipboard = value; } } },
+    CustomEvent: class { constructor(type, options) { this.type = type; this.detail = options.detail; } },
+  });
+  const change = (selector, value) => {
+    const element = node(selector);
+    if (value !== undefined) element.value = value;
+    element.listeners.get("change")({ target: element });
+  };
+  return { node, modes, builder, form, events, notes: () => window.SBSPackages.composeNotes("Local fixture; no submission."),
+    async copy() { await node("#copy-inquiry").listeners.get("click")(); return clipboard; },
+    select(coverage, mode, setup = "velvet", carpet = true) {
+      change(`input[name="package-mode"][value="${mode}"]`);
+      change(`input[name="coverage"][value="${coverage}"]`);
+      change("#setup-select", setup);
+      node("#carpet-option").checked = carpet;
+      change("#carpet-option");
+    },
+  };
+}
+
+test("all regular selections carry exact totals and media-only deposits into inquiry notes", () => {
+  const ui = page();
+  const media = { photo: [450, 135], film: [600, 180], both: [1000, 300] };
+  const settings = [
+    ["media", "velvet", false, [450, 600, 1000]],
+    ["bundle", "velvet", false, [1140, 1290, 1690]],
+    ["bundle", "velvet", true, [1200, 1350, 1750]],
+    ["bundle", "ultimate", false, [1340, 1490, 1890]],
+    ["bundle", "ultimate", true, [1400, 1550, 1950]],
+    ["bundle", "grand", true, [1600, 1750, 2150]],
+  ];
+  for (const [mode, setup, carpet, totals] of settings) {
+    for (const [index, coverage] of ["photo", "film", "both"].entries()) {
+      ui.select(coverage, mode, setup, carpet);
+      const [fee, deposit] = media[coverage];
+      const label = `${coverage}/${mode}/${setup}/${carpet}`;
+      assert.equal(ui.node("#package-total").textContent, money(totals[index]), label);
+      assert.equal(ui.node("#inquiry-package-price").textContent, money(totals[index]), label);
+      assert.equal(ui.node("#media-line-price").textContent, money(fee), label);
+      assert.equal(ui.node("[data-discount-line]").hidden, true, label);
+      assert.equal(ui.node("#media-deposit-note").textContent.includes(`${money(deposit)} (30% of the ${money(fee)} media fee)`), true, label);
+      assert.equal(ui.notes().includes(`Media: ${money(fee)}; media fee ${money(fee)}.`), true, label);
+      assert.equal(ui.notes().includes(`Package total: ${money(totals[index])}. Media reservation deposit (30%): ${money(deposit)}.`), true, label);
+      assert.equal(ui.notes().includes("bundle saving"), false, label);
+      assert.equal(ui.form.elements.coverage.value, coverage, label);
+      assert.equal(ui.events.at(-1).type, "sbs:coveragechange", label);
+      assert.equal(ui.events.at(-1).detail.coverage, coverage, label);
+    }
+  }
+  ui.select("both", "bundle", "grand", false);
+  assert.equal(ui.node("#package-total").textContent, "$2,150", "Grand carpet stays included");
+});
+
+test("regular savings never promise an extra decoration discount and copied inquiries retain attribution", async () => {
+  const ui = page();
+  ui.select("both", "bundle");
+  assert.equal(ui.node('[data-saving="both"]').hidden, false);
+  assert.equal(ui.node('[data-saving="both"]').textContent, "Save $50 compared with separate photo and film");
+  assert.equal(ui.node('[data-saving="photo"]').hidden, true);
+  assert.equal(ui.node('[data-saving="film"]').hidden, true);
+  assert.equal(ui.node("#saving-note").textContent.includes("$1,000 combined media rate saves $50"), true);
+  assert.equal(ui.node("#inquiry-package-saving").textContent, "Decoration is itemized at its listed partner price.");
+  const copied = await ui.copy();
+  assert.equal(copied.includes("Website package estimate: $1,750"), true);
+  assert.equal(copied.includes("Ad reference: 120255499730570357."), true);
+  ui.select("photo", "media");
+  assert.equal(ui.node("#saving-note").hidden, true);
+  assert.equal(ui.node("#inquiry-package-saving").textContent, "Coverage only. Decoration is priced separately.");
+});
+
+test("existing ad and UTM entry modes stay intact without restoring historical prices", () => {
+  for (const [search, mode, total] of [
+    ["?ad_id=120255499730570357", "bundle", "$1,750"],
+    ["?ad_id=120255494608960357", "media", "$1,000"],
+    ["?ad_id=120255494734630357", "media", "$1,000"],
+    ["?utm_content=package_1250_static", "bundle", "$1,750"],
+  ]) {
+    const ui = page(search);
+    assert.equal(ui.modes.find(input => input.checked).value, mode);
+    assert.equal(ui.node("#package-total").textContent, total);
+  }
+});
